-- ═══════════════════════════════════════════
-- LOG DE NOTIFICAÇÕES (máx 20 entradas)
-- ═══════════════════════════════════════════
local NotifLog   = {}
local MAX_NOTIFS = 20

local notifListLayout = nil  -- referência ao layout da lista de notifs
local notifScroll     = nil  -- referência ao ScrollingFrame de notifs

local function addNotif(text)
    local t = os.date("%H:%M:%S")
    table.insert(NotifLog, 1, string.format("[%s] %s", t, text))
    if #NotifLog > MAX_NOTIFS then
        table.remove(NotifLog, #NotifLog)
    end
    -- Atualiza UI se a aba de notifs estiver visível
    if notifScroll and notifScroll.Parent then
        for _, ch in ipairs(notifScroll:GetChildren()) do
            if ch:IsA("TextLabel") then ch:Destroy() end
        end
        for i, entry in ipairs(NotifLog) do
            local lbl = Instance.new("TextLabel")
            lbl.Size               = UDim2.new(1, 0, 0, 26)
            lbl.BackgroundColor3   = Color3.fromRGB(35, 20, 55)
            lbl.BackgroundTransparency = 0.2
            lbl.Text               = entry
            lbl.TextColor3         = Color3.fromRGB(220, 200, 255)
            lbl.TextSize           = 10
            lbl.FontFace           = FONT
            lbl.TextXAlignment     = Enum.TextXAlignment.Left
            lbl.TextWrapped        = true
            lbl.LayoutOrder        = i
            lbl.ZIndex             = 12
            lbl.Parent             = notifScroll
            Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 4)
            local ls = Instance.new("UIStroke")
            ls.Color       = Color3.fromRGB(20, 12, 35)
            ls.Thickness   = 1
            ls.Parent      = lbl
            local lp = Instance.new("UIPadding")
            lp.PaddingLeft  = UDim.new(0, 6)
            lp.PaddingRight = UDim.new(0, 6)
            lp.Parent       = lbl
        end
        if notifListLayout then
            notifScroll.CanvasSize = UDim2.new(0, 0, 0,
                notifListLayout.AbsoluteContentSize.Y + 10
            )
        end
    end
end

