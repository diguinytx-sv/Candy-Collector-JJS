    { icon = "🍬", label = "Funções"  },
    { icon = "📊", label = "Status"   },
    { icon = "🔔", label = "Log"      },
    { icon = "⚙️", label = "Config"   },
}

local tabBtns       = {}
local tabMenuOpen   = false
local autoHideTimer = nil

-- Cria os botões ATRÁS do painel (ZIndex = 5)
for i, def in ipairs(tabDefs) do
    local btn = Instance.new("TextButton")
    btn.Name             = "TabBtn" .. i
    btn.Size             = UDim2.fromOffset(TAB_BTN_SIZE, TAB_BTN_SIZE)
    -- Posição inicial: escondida atrás do painel (X = painel.Position + pequeno offset)
    btn.Position         = UDim2.new(0, 0, 0, 0)  -- será calculada após entrada
    btn.BackgroundColor3 = Color3.fromRGB(30, 18, 48)
    btn.Text             = def.icon
    btn.TextSize         = 18
    btn.FontFace         = FONT
    btn.AutoButtonColor  = false
    btn.ZIndex           = 5   -- ATRÁS do painel (ZIndex 10)
    btn.Active           = false  -- não recebe cliques quando escondido
    btn.Parent           = gui
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

    -- Gradiente igual ao painel
    local bg = Instance.new("UIGradient")
    bg.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(80, 45, 125)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(35, 18, 60)),
    })
    bg.Rotation = 135
    bg.Parent   = btn

    -- Borda com contraste
    local bs = Instance.new("UIStroke")
    bs.Thickness    = 1.5
    bs.Color        = Color3.fromRGB(200, 140, 255)
    bs.Transparency = 0.3
    bs.Parent       = btn

    -- Indicador de aba selecionada (linha na base)
    local indicator = Instance.new("Frame")
    indicator.Name             = "Indicator"
    indicator.Size             = UDim2.new(0.7, 0, 0, 3)
    indicator.Position         = UDim2.new(0.15, 0, 1, -5)
    indicator.BackgroundColor3 = Color3.fromRGB(255, 160, 50)
    indicator.BackgroundTransparency = 1  -- invisível por padrão
    indicator.BorderSizePixel  = 0
    indicator.ZIndex           = 6
    indicator.Parent           = btn
    Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)

    tabBtns[i] = btn
end

-- Calcula posição dos botões relativa ao painel
local function getTabBtnOpenPos(index)
    -- Botões saem para a ESQUERDA do painel
    -- Empilhados verticalmente, centralizados na altura do painel
    local panelAbsPos  = panel.AbsolutePosition
    local panelAbsSize = panel.AbsoluteSize

    local totalH    = #tabDefs * TAB_BTN_SIZE + (#tabDefs - 1) * TAB_BTN_GAP
    local startY    = panelAbsPos.Y + (panelAbsSize.Y / 2) - (totalH / 2)
    local btnY      = startY + (index - 1) * (TAB_BTN_SIZE + TAB_BTN_GAP)
    local btnX      = panelAbsPos.X - TAB_BTN_SIZE - 12  -- 12px de margem à esquerda

    return UDim2.fromOffset(btnX, btnY)
end

local function getTabBtnHiddenPos(index)
    -- Escondido atrás da borda esquerda do painel
    local panelAbsPos  = panel.AbsolutePosition
    local panelAbsSize = panel.AbsoluteSize

    local totalH    = #tabDefs * TAB_BTN_SIZE + (#tabDefs - 1) * TAB_BTN_GAP
    local startY    = panelAbsPos.Y + (panelAbsSize.Y / 2) - (totalH / 2)
    local btnY      = startY + (index - 1) * (TAB_BTN_SIZE + TAB_BTN_GAP)
    local btnX      = panelAbsPos.X  -- alinhado com a borda esquerda do painel

    return UDim2.fromOffset(btnX, btnY)
end

local function updateIndicators()
    for i, btn in ipairs(tabBtns) do
        local ind = btn:FindFirstChild("Indicator")
        if ind then
            ind.BackgroundTransparency = (i == currentTab) and 0 or 1
        end
        -- Borda mais brilhante na aba ativa
        local st = btn:FindFirstChildOfClass("UIStroke")
        if st then
            st.Color       = (i == currentTab)
                and Color3.fromRGB(255, 180, 80)
                or  Color3.fromRGB(200, 140, 255)
            st.Transparency = (i == currentTab) and 0 or 0.3
        end
    end
end

local function cancelAutoHide()
    if autoHideTimer then
        task.cancel(autoHideTimer)
        autoHideTimer = nil
    end
end

local function scheduleAutoHide()
    cancelAutoHide()
    autoHideTimer = task.delay(AUTO_HIDE_TIME, function()
        if not tabMenuOpen then return end
        -- Anima fechamento
        for i, btn in ipairs(tabBtns) do
            local hiddenPos = getTabBtnHiddenPos(i)
            local delay     = (i - 1) * 0.04
            task.delay(delay, function()
                TweenService:Create(btn,
                    TweenInfo.new(0.25, Enum.EasingStyle.Cubic, Enum.EasingDirection.In), {
                    Position        = hiddenPos,
                    Size            = UDim2.fromOffset(0, TAB_BTN_SIZE),
                    ImageTransparency = 1,
                }):Play()
                TweenService:Create(btn,
                    TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
                    BackgroundTransparency = 1,
                }):Play()
            end)
        end
        task.delay(0.35, function()
            tabMenuOpen = false
            for _, btn in ipairs(tabBtns) do
                btn.Active = false
                btn.Size   = UDim2.fromOffset(TAB_BTN_SIZE, TAB_BTN_SIZE)
                btn.BackgroundTransparency = 0
            end
        end)
    end)
end

local function openTabMenu()
    if tabMenuOpen then return end
    tabMenuOpen = true

    -- Atualiza posições baseadas na posição atual do painel
    for i, btn in ipairs(tabBtns) do
        local hiddenPos = getTabBtnHiddenPos(i)
        local openPos   = getTabBtnOpenPos(i)

        -- Inicia na posição escondida
        btn.Position               = hiddenPos
        btn.Size                   = UDim2.fromOffset(0, TAB_BTN_SIZE)
        btn.BackgroundTransparency = 1
        btn.Active                 = false

        -- Animação escalonada: cada botão sai com delay
        local delay = (i - 1) * 0.07
        task.delay(delay, function()
            btn.Active = true
            TweenService:Create(btn,
                TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Position               = openPos,
                Size                   = UDim2.fromOffset(TAB_BTN_SIZE, TAB_BTN_SIZE),
                BackgroundTransparency = 0,
            }):Play()
        end)
    end

    updateIndicators()
    scheduleAutoHide()
end

local function closeTabMenu()
    if not tabMenuOpen then return end
    cancelAutoHide()

    for i, btn in ipairs(tabBtns) do
        local hiddenPos = getTabBtnHiddenPos(i)
        local delay     = (i - 1) * 0.04

        task.delay(delay, function()
            btn.Active = false
            TweenService:Create(btn,
                TweenInfo.new(0.22, Enum.EasingStyle.Cubic, Enum.EasingDirection.In), {
                Position               = hiddenPos,
                Size                   = UDim2.fromOffset(0, TAB_BTN_SIZE),
                BackgroundTransparency = 1,
            }):Play()
        end)
    end

    task.delay(0.35, function()
        tabMenuOpen = false
        for _, btn in ipairs(tabBtns) do
            btn.Size                   = UDim2.fromOffset(TAB_BTN_SIZE, TAB_BTN_SIZE)
            btn.BackgroundTransparency = 0
        end
    end)
end

-- Ativa aba ao clicar no botão
for i, btn in ipairs(tabBtns) do
    btn.Activated:Connect(function()
        playClick()
        selectTab(i)
        updateIndicators()
        cancelAutoHide()
        scheduleAutoHide()
    end)
end

-- ═══════════════════════════════════════════
-- GESTO DE DESLIZE — borda esquerda do painel
-- Zona de 20px na borda esquerda
-- ═══════════════════════════════════════════
local GESTURE_ZONE_W = 20
local gestureActive  = false
local gestureStartX  = nil
local SWIPE_THRESHOLD = 30  -- pixels para considerar um swipe

local gestureConn = UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Touch
        and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
        return
    end

    local panelAbs  = panel.AbsolutePosition
    local panelSize = panel.AbsoluteSize
    local pos       = input.Position

    -- Verifica se o toque está na zona de gesto (borda esquerda do painel)
    local inZoneX = pos.X >= panelAbs.X and pos.X <= panelAbs.X + GESTURE_ZONE_W
    local inZoneY = pos.Y >= panelAbs.Y and pos.Y <= panelAbs.Y + panelSize.Y

    if inZoneX and inZoneY then
        gestureActive = true
        gestureStartX = pos.X
    end
end)

local gestureEndConn = UserInputService.InputEnded:Connect(function(input)
    if not gestureActive then return end
    if input.UserInputType ~= Enum.UserInputType.Touch
        and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
        return
    end

    local delta = gestureStartX - input.Position.X
    gestureActive = false

    if delta > SWIPE_THRESHOLD then
        -- Swipe para a esquerda → abre
        if not tabMenuOpen then
            openTabMenu()
        end
    elseif delta < -SWIPE_THRESHOLD then
        -- Swipe para a direita → fecha
        if tabMenuOpen then
            closeTabMenu()
        end
    end
end)

table.insert(GlobalConns, gestureConn)
table.insert(GlobalConns, gestureEndConn)

-- ═══════════════════════════════════════════
-- MINIMIZAR
-- ═══════════════════════════════════════════
local EASING_IN     = TweenInfo.new(0.45, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
local EASING_RESIZE = TweenInfo.new(0.3,  Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
local minimized     = false

minBtn.Activated:Connect(function()
    playClick()
    minimized    = not minimized
    minBtn.Text  = minimized and "+" or "−"

    TweenService:Create(panel, EASING_RESIZE, {
        Size = minimized and MINI_SIZE or PANEL_SIZE,
    }):Play()

    tabContainer.Visible = not minimized
    headerSep.Visible    = not minimized

    -- Recolhe menu de abas ao minimizar
    if minimized and tabMenuOpen then closeTabMenu() end
end)

