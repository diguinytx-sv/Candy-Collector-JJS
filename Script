-- ═══════════════════════════════════════════
-- DOOR INVISIBILITY
-- FIX: salva posição ANTES de mover o HRP
-- FIX: CameraSubject = ghostPart (câmera livre)
-- FIX: MoveDirection sem dupla transformação
-- ═══════════════════════════════════════════
local function startInvis()
    local hrp  = getHRP()
    local char = player.Character
    local hum  = getHumanoid()
    if not hrp or not char or not hum then return end

    -- FIX: salva posição ANTES de qualquer movimento
    local originalPosition = hrp.Position

    State.originalCamSubject = camera.CameraSubject

    -- Esconde o corpo
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            p.LocalTransparencyModifier = 1
        end
    end

    -- Ancora o corpo em Y=5000 DEPOIS de salvar a posição
    hrp.Anchored = true
    hrp.CFrame   = CFrame.new(0, 5000, 0)

    -- Cria ghostPart na posição ORIGINAL do player
    if ghostPart then ghostPart:Destroy() end
    ghostPart               = Instance.new("Part")
    ghostPart.Name          = "CandyGhost"
    ghostPart.Size          = Vector3.new(2, 5, 1)
    ghostPart.Transparency  = 1
    ghostPart.CanCollide    = true
    ghostPart.Anchored      = false
    ghostPart.CastShadow    = false
    ghostPart.CFrame        = CFrame.new(originalPosition)  -- FIX: posição correta
    ghostPart.Parent        = workspace

    -- BodyVelocity para movimento horizontal
    local bv        = Instance.new("BodyVelocity")
    bv.Velocity     = Vector3.zero
    bv.MaxForce     = Vector3.new(1e5, 0, 1e5)
    bv.Parent       = ghostPart

    -- BodyGyro para não tombar
    local bg        = Instance.new("BodyGyro")
    bg.MaxTorque    = Vector3.new(0, 1e5, 0)
    bg.P            = 1e4
    bg.CFrame       = ghostPart.CFrame
    bg.Parent       = ghostPart

    -- Câmera segue o ghostPart em terceira pessoa
    camera.CameraType    = Enum.CameraType.Custom
    camera.CameraSubject = ghostPart

    if Connections.ghost then Connections.ghost:Disconnect() end

    local SPEED = 16
    Connections.ghost = RunService.Heartbeat:Connect(function()
        if not State.invis or not ghostPart then return end

        local hum2 = getHumanoid()
        local bvObj = ghostPart:FindFirstChildOfClass("BodyVelocity")
        if not bvObj then return end

        -- FIX: MoveDirection já é relativo ao mundo — sem dupla transformação
        local vel = Vector3.zero
        if hum2 and hum2.MoveDirection.Magnitude > 0 then
            vel = hum2.MoveDirection * SPEED
        end
        bvObj.Velocity = vel

        -- Mantém HRP ancorado
        local h = getHRP()
        if h then
            h.CFrame = CFrame.new(0, 5000, 0)
            h.AssemblyLinearVelocity  = Vector3.zero
            h.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end

local function stopInvis()
    State.invis = false

    if Connections.ghost then
        Connections.ghost:Disconnect()
        Connections.ghost = nil
    end

    local char = player.Character
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                p.LocalTransparencyModifier = 0
            end
        end
    end

    local hrp = getHRP()
    if hrp and ghostPart then
        hrp.Anchored = false
        hrp.CFrame   = CFrame.new(ghostPart.Position)
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    elseif hrp then
        hrp.Anchored = false
    end

    if ghostPart then
        ghostPart:Destroy()
        ghostPart = nil
    end

    -- FIX: restaura câmera com CameraSubject do Humanoid atual
    camera.CameraType = Enum.CameraType.Custom
    local hum = getHumanoid()
    camera.CameraSubject = hum
        or State.originalCamSubject
end

