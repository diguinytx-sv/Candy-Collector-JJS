-- FECHAR
-- ═══════════════════════════════════════════
closeBtn.Activated:Connect(function()
    playClick()
    stopAutoCandy()
    stopAutoPrompt()
    if State.invis       then stopInvis()         end
    if State.doorESP     then removeAllESP()      end
    if State.instantDoor then removeInstantDoor() end
    if State.speedBoost  then stopSpeedBoost()    end
    if statusUpdateConn  then statusUpdateConn:Disconnect() end
    cancelAutoHide()

    for _, conn in ipairs(GlobalConns) do conn:Disconnect() end
    GlobalConns = {}

    -- Remove botões de aba
    for _, btn in ipairs(tabBtns) do btn:Destroy() end

    TweenService:Create(panel, TweenInfo.new(0.2, Enum.EasingStyle.Cubic), {
        BackgroundTransparency = 1,
        Size                   = UDim2.fromOffset(0, 0),
    }):Play()
    task.delay(0.25, function() gui:Destroy() end)
end)

-- ═══════════════════════════════════════════
-- ARRASTAR — header, ignora botões fechar/min
-- ═══════════════════════════════════════════
local dragging    = false
local dragStart   = nil
local startPanelPos = nil
local activeInput = nil

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        local pos = input.Position
        local function inside(btn)
            local ap = btn.AbsolutePosition
            local as = btn.AbsoluteSize
            return pos.X >= ap.X and pos.X <= ap.X + as.X
               and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y
        end
        if inside(closeBtn) or inside(minBtn) then return end

        dragging      = true
        dragStart     = input.Position
        startPanelPos = panel.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

header.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        activeInput = input
    end
end)

local dragConn = UserInputService.InputChanged:Connect(function(input)
    if dragging and input == activeInput then
        local delta = input.Position - dragStart
        panel.Position = UDim2.new(
            startPanelPos.X.Scale,
            startPanelPos.X.Offset + delta.X,
            startPanelPos.Y.Scale,
            startPanelPos.Y.Offset + delta.Y
        )
        -- Recolhe o menu ao arrastar (posições mudariam)
        if tabMenuOpen then closeTabMenu() end
    end
end)
table.insert(GlobalConns, dragConn)

