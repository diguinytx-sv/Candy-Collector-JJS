-- ═══════════════════════════════════════════
-- DETECÇÃO DE PORTAS
-- ═══════════════════════════════════════════
local function getDoorPrompts()
    local result = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "door" and obj:IsA("BasePart") and obj.Parent then
            local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
            if prompt then
                table.insert(result, { part = obj, prompt = prompt })
            end
        end
    end
    return result
end

local function firePromptSafe(prompt)
    if not prompt or not prompt.Parent then return end
    local orig = prompt.MaxActivationDistance
    prompt.MaxActivationDistance = math.huge
    pcall(function() fireproximityprompt(prompt) end)
    task.wait(0.05)
    if prompt and prompt.Parent then
        prompt.MaxActivationDistance = orig
    end
end

-- ═══════════════════════════════════════════
-- DOOR ESP
-- ═══════════════════════════════════════════
local function addESP(part)
    if not part or not part.Parent then return end
    if part:FindFirstChild("_CandyESP") then return end
    local h = Instance.new("Highlight")
    h.Name               = "_CandyESP"
    h.FillTransparency   = 0.6
    h.FillColor          = Color3.fromRGB(255, 120, 0)
    h.OutlineColor       = Color3.fromRGB(255, 220, 50)
    h.OutlineTransparency = 0
    h.Parent             = part
    espHighlights[part]  = h
end

local function removeAllESP()
    for _, h in pairs(espHighlights) do
        if h and h.Parent then h:Destroy() end
    end
    espHighlights = {}
    if Connections.espWatch then
        Connections.espWatch:Disconnect()
        Connections.espWatch = nil
    end
end

local function startDoorESP()
    for _, d in ipairs(getDoorPrompts()) do addESP(d.part) end
    if Connections.espWatch then Connections.espWatch:Disconnect() end
    Connections.espWatch = workspace.DescendantAdded:Connect(function(obj)
        if not State.doorESP then return end
        if obj.Name == "door" and obj:IsA("BasePart") then
            task.wait(0.1)
            addESP(obj)
        end
    end)
end

-- ═══════════════════════════════════════════
-- INSTANT DOOR
-- ═══════════════════════════════════════════
local function applyInstantDoor()
    for _, d in ipairs(getDoorPrompts()) do
        if not instantDoorOriginals[d.prompt] then
            instantDoorOriginals[d.prompt] = d.prompt.HoldDuration
        end
        d.prompt.HoldDuration = 0
    end
end

local function removeInstantDoor()
    for prompt, original in pairs(instantDoorOriginals) do
        if prompt and prompt.Parent then
            prompt.HoldDuration = original
        end
    end
    instantDoorOriginals = {}
    if Connections.instantWatch then
        Connections.instantWatch:Disconnect()
        Connections.instantWatch = nil
    end
end

local function startInstantDoorWatcher()
    if Connections.instantWatch then Connections.instantWatch:Disconnect() end
    Connections.instantWatch = workspace.DescendantAdded:Connect(function(obj)
        if not State.instantDoor then return end
        if obj.Name == "door" and obj:IsA("BasePart") then
            local attempts = 0
            repeat
                task.wait(0.2)
                attempts = attempts + 1
                local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
                if prompt then
                    instantDoorOriginals[prompt] = prompt.HoldDuration
                    prompt.HoldDuration = 0
                    break
                end
            until attempts >= 10
        end
    end)
end

-- ═══════════════════════════════════════════
-- AUTO CANDY
-- ═══════════════════════════════════════════
local function startAutoCandy()
    if LoopFlags.autoCandy then return end
    LoopFlags.autoCandy = true

    task.spawn(function()
        while LoopFlags.autoCandy do
            local doors = getDoorPrompts()
            if #doors == 0 then task.wait(2) continue end

            for _, d in ipairs(doors) do
                if not LoopFlags.autoCandy then break end
                if not d.part.Parent or not d.prompt.Parent then continue end

                local hrp = getHRP()
                if not hrp then break end

                if activeCandyTween then
                    activeCandyTween:Cancel()
                    activeCandyTween = nil
                end

                activeCandyTween = TweenService:Create(
                    hrp,
                    TweenInfo.new(State.tweenSpeed, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    { CFrame = CFrame.new(d.part.Position + Vector3.new(0, 4, 0)) }
                )
                activeCandyTween:Play()
                activeCandyTween.Completed:Wait()
                activeCandyTween = nil

                if not LoopFlags.autoCandy then break end

                firePromptSafe(d.prompt)

                local partRef = d.part
                local timeout = tick() + 4
                repeat task.wait(0.15)
                until not partRef.Parent or tick() > timeout

                if not partRef.Parent then
                    Stats.doorsOpened    = Stats.doorsOpened + 1
                    Stats.candyCollected = Stats.candyCollected + 15
                    addNotif("🍬 Porta coletada (+15 candy)")
                end

                task.wait(0.3)
            end
            task.wait(1.5)
        end
    end)
end

local function stopAutoCandy()
    LoopFlags.autoCandy = false
    State.autoCandy     = false
    if activeCandyTween then
        activeCandyTween:Cancel()
        activeCandyTween = nil
    end
end

