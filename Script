-- ═══════════════════════════════════════════
-- DETECÇÃO DE PORTAS
-- Busca Part "door" com ProximityPrompt filho direto
-- Valida se a referência ainda existe antes de retornar
-- ═══════════════════════════════════════════
local function getDoorPrompts()
    local result = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "door"
            and obj:IsA("BasePart")
            and obj.Parent  -- ainda existe no Workspace
        then
            local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
            if prompt then
                table.insert(result, { part = obj, prompt = prompt })
            end
        end
    end
    return result
end

local function firePromptSafe(prompt)
    if not prompt or not prompt.Parent then return end
    local orig = prompt.MaxActivationDistance
    prompt.MaxActivationDistance = math.huge
    pcall(function() fireproximityprompt(prompt) end)
    task.wait(0.05)
    if prompt and prompt.Parent then
        prompt.MaxActivationDistance = orig
    end
end

-- ═══════════════════════════════════════════
-- INSTANT DOOR
-- ═══════════════════════════════════════════
local instantDoorOriginals = {}

local function applyInstantDoor()
    local doors = getDoorPrompts()
    for _, d in ipairs(doors) do
        if not instantDoorOriginals[d.prompt] then
            instantDoorOriginals[d.prompt] = d.prompt.HoldDuration
        end
        d.prompt.HoldDuration = 0
    end
end

local function removeInstantDoor()
    for prompt, original in pairs(instantDoorOriginals) do
        if prompt and prompt.Parent then
            prompt.HoldDuration = original
        end
    end
    instantDoorOriginals = {}
end

local function startInstantDoorWatcher()
    if Connections.instantWatch then
        Connections.instantWatch:Disconnect()
    end
    Connections.instantWatch = workspace.DescendantAdded:Connect(function(obj)
        if not State.instantDoor then return end
        if obj.Name == "door" and obj:IsA("BasePart") then
            -- Aguarda até o ProximityPrompt existir (até 2s)
            local attempts = 0
            repeat
                task.wait(0.2)
                attempts = attempts + 1
                local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
                if prompt then
                    instantDoorOriginals[prompt] = prompt.HoldDuration
                    prompt.HoldDuration = 0
                    break
                end
            until attempts >= 10
        end
    end)
end

local function stopInstantDoorWatcher()
    if Connections.instantWatch then
        Connections.instantWatch:Disconnect()
        Connections.instantWatch = nil
    end
end

-- ═══════════════════════════════════════════
-- AUTO CANDY
-- FIX: flag de controle de loop + cancelamento de tween ativo
-- FIX: confirmação de coleta por desaparecimento da Part
-- ═══════════════════════════════════════════
local function startAutoCandy()
    -- Garante que loop anterior terminou
    if LoopFlags.autoCandy then return end
    LoopFlags.autoCandy = true

    task.spawn(function()
        while LoopFlags.autoCandy do
            local doors = getDoorPrompts()

            if #doors == 0 then
                task.wait(2)
                continue
            end

            for _, d in ipairs(doors) do
                if not LoopFlags.autoCandy then break end

                -- Valida referência antes de usar
                if not d.part.Parent or not d.prompt.Parent then
                    continue
                end

                local hrp = getHRP()
                if not hrp then break end

                local dest = CFrame.new(
                    d.part.Position + Vector3.new(0, 4, 0)
                )

                -- Cancela tween anterior se ainda estiver rodando
                if activeCandyTween then
                    activeCandyTween:Cancel()
                    activeCandyTween = nil
                end

                activeCandyTween = TweenService:Create(
                    hrp,
                    TweenInfo.new(
                        State.tweenSpeed,
                        Enum.EasingStyle.Quad,
                        Enum.EasingDirection.Out
                    ),
                    { CFrame = dest }
                )
                activeCandyTween:Play()
                activeCandyTween.Completed:Wait()
                activeCandyTween = nil

                if not LoopFlags.autoCandy then break end

                -- Dispara o prompt
                firePromptSafe(d.prompt)

                -- FIX: confirmação real — espera a Part desaparecer
                -- (quando a porta abre, a Part "door" é removida ou muda de Parent)
                local timeout  = tick() + 3
                local partRef  = d.part
                repeat
                    task.wait(0.15)
                until not partRef.Parent or tick() > timeout

                task.wait(0.3)
            end

            task.wait(1.5)
        end
    end)
end

local function stopAutoCandy()
    LoopFlags.autoCandy = false
    State.autoCandy     = false
    -- Cancela tween em andamento
    if activeCandyTween then
        activeCandyTween:Cancel()
        activeCandyTween = nil
    end
end

