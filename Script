-- PUMPKIN EVENT
-- ═══════════════════════════════════════════
local function findPumpkinCarrier()
    for _, p in ipairs(Players:GetPlayers()) do
        local char = p.Character
        if char then
            local acc = char:FindFirstChild("Pumpkin")
            if acc and acc:IsA("Accessory") then
                return p, char
            end
        end
    end
    return nil, nil
end

-- ═══════════════════════════════════════════
-- TELEPORT TO TOWER
-- ═══════════════════════════════════════════
local function doTeleport()
    local hrp = getHRP()
    if not hrp then return end
    hrp.Anchored = true
    hrp.CFrame   = CFrame.new(TowerPosition + Vector3.new(0, 5, 0))
    task.delay(1, function()
        local h = getHRP()
        if h then
            h.Anchored = false
            h.AssemblyLinearVelocity  = Vector3.zero
            h.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end

