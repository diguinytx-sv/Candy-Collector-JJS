-- ═══════════════════════════════════════════
-- SPEED BOOST
-- ═══════════════════════════════════════════
local speedConn = nil

local function applySpeed(value)
    local hum = getHumanoid()
    if hum then hum.WalkSpeed = math.floor(value) end
end

local function startSpeedBoost(value)
    local hum = getHumanoid()
    State.originalSpeed = hum and hum.WalkSpeed or 16
    applySpeed(value)
    if speedConn then speedConn:Disconnect() end
    speedConn = RunService.Heartbeat:Connect(function()
        if not State.speedBoost then
            speedConn:Disconnect()
            speedConn = nil
            return
        end
        local h = getHumanoid()
        if h and h.WalkSpeed ~= math.floor(speedValue) then
            h.WalkSpeed = math.floor(speedValue)
        end
    end)
    addNotif(string.format("💨 Speed Boost: %d", math.floor(value)))
end

local function stopSpeedBoost()
    State.speedBoost = false
    if speedConn then speedConn:Disconnect() speedConn = nil end
    applySpeed(State.originalSpeed)
end

